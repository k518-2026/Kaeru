<UserControl x:Class="IWorkConverter.App.IWorkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Brush.Canvas}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <!-- 旧 iWorkConverter（2026-11-02 に Kaeru へ統合）。見た目はこのタブの中だけに効かせる -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Kaeru;component/IWork/Themes/Theme.xaml" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ヘッダー -->
            <RowDefinition Height="Auto"/>   <!-- ツールバー -->
            <RowDefinition Height="*"/>      <!-- 一覧 + サイドパネル -->
            <RowDefinition Height="Auto"/>   <!-- ログ -->
            <RowDefinition Height="Auto"/>   <!-- フッター -->
        </Grid.RowDefinitions>

        <!-- ================= ヘッダー ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Brush.Accent}"
                        VerticalAlignment="Center">
                    <TextBlock Text="iW" Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="iWork Converter" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Pages → .docx　·　Numbers → .xlsx　·　Keynote → .pptx"
                               Style="{StaticResource Text.Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= ツールバー ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="＋ ファイルを追加" Style="{StaticResource Button.Secondary}"
                        Command="{Binding AddFilesCommand}"/>
                <Button Content="フォルダを追加" Style="{StaticResource Button.Secondary}"
                        Command="{Binding AddFolderCommand}"/>
                <Button Content="クリア" Style="{StaticResource Button.Ghost}"
                        Command="{Binding ClearCommand}"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding StatusLine}" Style="{StaticResource Text.Sub}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ================= メイン ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ファイル一覧 / ドロップゾーン -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Surface}"
                                            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1"
                                            CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 種別バッジ -->
                                            <Border Grid.Column="0" CornerRadius="7" Padding="9,5"
                                                    VerticalAlignment="Center" MinWidth="58"
                                                    Background="{Binding BadgeBackground}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{Binding BadgeForeground}"/>
                                            </Border>

                                            <!-- ファイル名と詳細 -->
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Route}" Style="{StaticResource Text.Sub}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Sub}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detail}"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- 状態ピル -->
                                            <Border Grid.Column="2" CornerRadius="10" Padding="11,4" MinWidth="62"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <!-- 削除 -->
                                            <Button Grid.Column="3" Content="✕" Margin="8,0,0,0"
                                                    Style="{StaticResource Button.Icon}"
                                                    ToolTip="一覧から外す"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空のときのドロップゾーン -->
                    <Grid Margin="10" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.6" StrokeDashArray="5 4">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="#CBD2DC"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}"/>
                                            <Setter Property="Fill" Value="{StaticResource Brush.AccentSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource Brush.AccentSoft}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="↓" FontSize="24" Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ここにファイルをドラッグ＆ドロップ" Margin="0,16,0,0"
                                       FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"/>
                            <TextBlock Text=".pages / .numbers / .key　フォルダをまとめて入れることもできます"
                                       Style="{StaticResource Text.Sub}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 設定パネル -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="18,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="出力先" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource TextBox.Modern}"
                                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="空欄のときは元ファイルと同じフォルダに出力します"/>
                        <TextBlock Text="空欄 = 元ファイルと同じ場所" Style="{StaticResource Text.Sub}"
                                   Margin="2,6,0,10" Foreground="{StaticResource Brush.TextMuted}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="参照…" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding ChooseOutputCommand}"/>
                            <Button Content="フォルダを開く" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenOutputCommand}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Brush.Hairline}" Margin="0,18,0,16"/>

                        <TextBlock Text="変換オプション" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DetectHeadings}"
                                  Content="見出しを推定する（Pages）"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeFloatingText}"
                                  Content="テキストボックスも取り込む"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SkipEmptySlides}"
                                  Content="空スライドを除外（Keynote）"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BoldFirstRow}"
                                  Content="1 行目を太字に（Numbers）"/>

                        <Border Height="1" Background="{StaticResource Brush.Hairline}" Margin="0,10,0,16"/>

                        <TextBlock Text="動作" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Overwrite}"
                                  Content="同名ファイルを上書き"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OpenWhenDone}"
                                  Content="完了後にフォルダを開く"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= ログ ================= -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ToggleButton x:Name="LogToggle" Content="ログ" HorizontalAlignment="Left"
                          Style="{StaticResource Toggle.Disclosure}"/>
            <Border Style="{StaticResource Card}" Background="{StaticResource Brush.Ink}" BorderBrush="{StaticResource Brush.Ink}"
                    Padding="14,12" Height="150" Margin="0,8,0,0"
                    Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Brush.InkText}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- ================= フッター ================= -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <ProgressBar Style="{StaticResource Progress.Slim}" Value="{Binding Progress, Mode=OneWay}" Maximum="100"/>
            </StackPanel>

            <Button Grid.Column="1" Content="変換を開始" Style="{StaticResource Button.Primary}"
                    MinWidth="170" Margin="0" Command="{Binding ConvertCommand}"/>
        </Grid>
    </Grid>
</UserControl>
