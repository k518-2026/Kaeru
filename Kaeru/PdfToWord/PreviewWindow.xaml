<Window x:Class="PdfToWord.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="読み取った中身"
        Width="820"
        Height="640"
        Background="{DynamicResource BgBrush}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary Source="/Kaeru;component/PdfToWord/Themes/Theme.xaml" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,4,0,0"
                       Text="変換後の組み立て方を文字だけで示したものです。# は見出し、｜ 区切りは表を表します。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <TextBox x:Name="Body"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="12"
                     FontSize="13"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="文字をコピー" Style="{StaticResource GhostButton}" Padding="16,9" Click="OnCopy" />
            <Button Content="閉じる" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
