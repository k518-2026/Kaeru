<Window x:Class="Kaeru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaeru － Word / PDF を LaTeX・Markdown・ODF に変換"
        Height="680" Width="1000" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="Yu Gothic UI" FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Kaeru 文書変換" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Word (.docx) と PDF (.pdf) を LaTeX (.tex) / Markdown (.md) / ODF テキスト (.odt) に変換します。ファイルはドラッグ＆ドロップでも追加できます。"
                       Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 本体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="変換するファイル">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="FileList" Grid.Row="0" Margin="6"
                             AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
                             SelectionMode="Extended"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FullPath}" Foreground="#777" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,6,6">
                        <Button Content="ファイルを追加..." Click="AddFiles_Click"/>
                        <Button Content="選択を削除" Click="RemoveSelected_Click"/>
                        <Button Content="すべて削除" Click="ClearAll_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="出力形式" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkMarkdown" Content="Markdown (.md)" IsChecked="True"/>
                        <CheckBox x:Name="ChkLatex" Content="LaTeX (.tex)" IsChecked="True"/>
                        <CheckBox x:Name="ChkOdf" Content="ODF テキスト (.odt)" IsChecked="True"/>

                        <TextBlock Text="LaTeX テンプレート" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="CmbLatexTemplate" SelectedIndex="0">
                            <ComboBoxItem Content="日本語 ltjsarticle（LuaLaTeX）"/>
                            <ComboBoxItem Content="日本語 jsarticle（upLaTeX + dvipdfmx）"/>
                            <ComboBoxItem Content="欧文 article（pdfLaTeX）"/>
                        </ComboBox>

                        <TextBlock Text="オプション" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkImages" Content="画像を media フォルダーに書き出す" IsChecked="True"/>
                        <CheckBox x:Name="ChkFrontMatter" Content="Markdown に YAML フロントマターを付ける" IsChecked="True"/>
                        <CheckBox x:Name="ChkStripHeads" Content="PDF のヘッダー・ページ番号を除去する" IsChecked="True"/>
                        <CheckBox x:Name="ChkOverwrite" Content="同名ファイルを上書きする" IsChecked="False"/>

                        <TextBlock Text="出力先" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkSameFolder" Content="入力ファイルと同じ場所に出力"
                                  IsChecked="True" Checked="SameFolder_Changed" Unchecked="SameFolder_Changed"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="参照..." Click="BrowseOutput_Click"
                                    x:Name="BtnBrowseOutput" IsEnabled="False" MinWidth="60" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtOutputDir" IsEnabled="False" VerticalContentAlignment="Center" Padding="4,3"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- 進捗 -->
        <ProgressBar x:Name="Progress" Grid.Row="2" Height="8" Margin="0,12,0,8" Minimum="0" Maximum="100"/>

        <!-- ログ -->
        <GroupBox Grid.Row="3" Header="ログ">
            <TextBox x:Name="TxtLog" Margin="4" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Yu Gothic UI" FontSize="12" Background="#FAFAFA"/>
        </GroupBox>

        <!-- フッター -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#555"/>
            <Button x:Name="BtnOpenOutput" Content="出力先を開く" Click="OpenOutput_Click" IsEnabled="False"/>
            <Button x:Name="BtnConvert" Content="変換する" Click="Convert_Click"
                    MinWidth="120" FontWeight="Bold" Padding="14,6"/>
        </StackPanel>
    </Grid>
</Window>
