<Window x:Class="Kaeru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kaeru="clr-namespace:Kaeru"
        xmlns:pdf="clr-namespace:PdfToWord"
        xmlns:iwork="clr-namespace:IWorkConverter.App"
        Title="Kaeru 文書変換"
        Height="820" Width="1120" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13">

    <!--
        2026-11-02 に 3 つのアプリを 1 つにまとめた。タブごとに元のアプリの画面と処理をそのまま使う。
          1. Word / PDF → LaTeX・Markdown・ODT（もとの Kaeru）
          2. PDF → Word（旧 PdfToWord）
          3. iWork → Office（旧 iWorkConverter）
    -->
    <TabControl x:Name="Tabs" Padding="0" BorderThickness="0,1,0,0">
        <TabItem Header="  Word・PDF → LaTeX / Markdown / ODT  ">
            <kaeru:DocConvertView />
        </TabItem>
        <TabItem Header="  PDF → Word  ">
            <pdf:PdfToWordView />
        </TabItem>
        <TabItem Header="  iWork → Office  ">
            <iwork:IWorkView />
        </TabItem>
    </TabControl>
</Window>
